# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.pfx
*.pk8
*.mobileprovision
google-services.json
GoogleService-Info.plist

# signing material and secrets (the Android keystore and passwords live only in GitHub secrets)
.env
.env.*
!.env.example
**/private*.pem
**/*-private*

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# The public OTA code-signing certificate ships in the APK and is the only .pem that may be
# committed. The private key lives outside the repository (docs/SECURITY-OTA-SIGNING.md).
!/certs/certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated update site
site/

# Local test-run output (it records absolute paths of the machine it ran on)
.vitest/
