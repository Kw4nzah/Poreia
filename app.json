{
  "expo": {
    "name": "Poreia",
    "slug": "poreia",
    "scheme": "poreia",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "4",
    "updates": {
      "url": "https://kw4nzah.github.io/Poreia/updates/android/4/manifest.json",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.kw4nzah.poreia",
      "versionCode": 6,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#7A1F2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-notifications",
      "expo-updates",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PoreiaFast",
              "label": "Poreia",
              "description": "Today's fast, what is allowed and today's feast.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 360,
          "backgroundColor": "#7A1F2B",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#7A1F2B" }
        }
      ]
    ]
  }
}
